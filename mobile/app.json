{
  "expo": {
    "name": "Tomb of Light",
    "slug": "tomboflight-mobile",
    "scheme": "tomboflight",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF3FA"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tomb of Light uses your photo library when you choose a family portrait or upload image evidence.",
          "cameraPermission": "Tomb of Light uses your camera when you take a family portrait.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tomboflight.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tomb of Light uses your camera when you take a family portrait.",
        "NSPhotoLibraryUsageDescription": "Tomb of Light uses your photo library when you choose a family portrait or upload image evidence."
      }
    },
    "android": {
      "package": "com.tomboflight.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://tomboflight-api.onrender.com",
      "router": {},
      "eas": {
        "projectId": "e7b05db9-294d-4509-a16b-70b0f02e8b82"
      }
    },
    "owner": "tomb-of-light"
  }
}
